# ============ GitHub OAuth ============
# 在 https://github.com/settings/developers 创建 OAuth App 后填写
# 注意：回调地址必须是 /api/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
# 本地开发填 http://localhost:8000/api/auth/github/callback
# 部署到 Render 后改成 https://<后端域名>/api/auth/github/callback（要和 GitHub App 里填的一致）
GITHUB_OAUTH_CALLBACK_URL=http://localhost:8000/api/auth/github/callback

# ============ 管理员 ============
# 只有这个 GitHub 用户名可以登录后管理内容（role=admin，其他人 role=reader）
ADMIN_GITHUB_LOGIN=chenji0421

# ============ 会话密钥 ============
# 用于签发/验证 JWT，部署时务必改成随机长字符串（openssl rand -hex 32）
AUTH_SECRET=change_me_to_a_long_random_string_at_least_32_chars
# 过期时间（分钟），默认 7 天
AUTH_EXPIRE_MINUTES=10080

# ============ 前端地址 ============
# 用于 OAuth 回调跳转，也会自动加进后端 CORS 白名单
# 本地开发填 http://localhost:5173
# 部署到 Vercel 后改成 https://<前端域名>.vercel.app
FRONTEND_URL=http://localhost:5173

# ============ 数据库 ============
# 第一版用 SQLite，文件在运行目录下生成
# 部署到 Render 后改成 Render 提供的 PostgreSQL 连接串，例如：
# postgresql://chenji_hub:<密码>@<主机>:5432/chenji_hub
# （render.yaml 会自动注入，手动部署时填这个）
DATABASE_URL=sqlite:///./chenji_hub.db
